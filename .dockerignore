# Version control and CI metadata
.git
.github

# Local environment and secrets
.venv
.env
.env.*
!.env.example

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
.tmp/

# IDE and editor metadata
.claude/
.cursor/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Tests, deliverables, and experiments (not required at runtime)
tests/
deliverables/
experiments/

# Documentation (README.md is required for package install)
docs/
*.md
!README.md

# Corpus and generated data (production index is bind-mounted at runtime)
data/01_raw/
data/02_clean_markdown/
data/03_chunks/
data/04_index/
data/04_index_backup_10docs_215chunks/
data/04_index_production/
data/04_index_experiments/
data/05_evaluation/

# Local Chroma index patterns
data/04_index*/
