OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Production release posture (answer-claim / Streamlit). Index path comes from
# configs/release/production_posture.json — not from RAG_INDEX_DIR.
# Set RAG_RELEASE_TARGET=rollback only for emergency rollback (15-document archive).
RAG_RELEASE_TARGET=active

# Used by build-index, search-index, and evaluation CLIs only — not production answer/UI.
RAG_INDEX_DIR=data/04_index
RAG_COLLECTION_NAME=customer_claims
RAG_TOP_K=4
RAG_FETCH_K=12
RAG_SIMILARITY_THRESHOLD=0.0
RAG_EMBEDDING_BATCH_SIZE=64

GENERATION_TEMPERATURE=0.0
GENERATION_TIMEOUT_SECONDS=60
GENERATION_MAX_RETRIES=2
GENERATION_MAX_OUTPUT_TOKENS=1024
GENERATION_PROMPT_PATH=prompts/grounded_answer_v1.md
