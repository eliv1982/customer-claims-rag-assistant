OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Production release posture (answer-claim / Streamlit). Index path comes from
# configs/release/production_posture.json — not from RAG_INDEX_DIR.
# `active` is the only target: the canonical production corpus. Its index is built from the
# repository (docs/07_index_provisioning.md), never copied from an archive.
RAG_RELEASE_TARGET=active

# Docker Compose only: host-side bind mount for the active production index.
# Container path is fixed by the release descriptor (/app/data/04_index_production).
# RAG_ACTIVE_INDEX_HOST_PATH=./data/04_index_production

# Container/non-editable installs: set to /app in Docker (see Dockerfile).
# CUSTOMER_CLAIMS_PROJECT_ROOT=/app

# Used by build-index, search-index, and evaluation CLIs only — not production answer/UI.
RAG_INDEX_DIR=data/04_index
RAG_COLLECTION_NAME=customer_claims
RAG_TOP_K=4
RAG_FETCH_K=12
RAG_SIMILARITY_THRESHOLD=0.0
RAG_EMBEDDING_BATCH_SIZE=64

GENERATION_TEMPERATURE=0.0
GENERATION_TIMEOUT_SECONDS=60
GENERATION_MAX_RETRIES=2
GENERATION_MAX_OUTPUT_TOKENS=1024
GENERATION_PROMPT_PATH=prompts/system_prompt.md
